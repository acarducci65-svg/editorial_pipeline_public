<!doctype html>
<html lang="it">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta http-equiv="Content-Security-Policy" content="default-src 'none'; script-src 'unsafe-inline'; style-src 'unsafe-inline'; img-src 'self' file: data:; media-src 'self' file:; frame-src 'self' about:; connect-src 'none'; font-src 'none'; base-uri 'none'; form-action 'none'">
<title>{{ title }} · Editorial Hub</title>
<style>
:root{color-scheme:light;--ink:#172b38;--muted:#526372;--paper:#f8fafc;--accent:#11635d;--line:#e2e8f0;--card:#ffffff;--serif:Georgia,Cambria,'Iowan Old Style',serif;--sans:system-ui,-apple-system,'Segoe UI',Roboto,sans-serif}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--paper);color:var(--ink);font:16px/1.65 var(--sans)}a{color:var(--accent);text-underline-offset:4px;overflow-wrap:anywhere}button,a.download{min-height:44px;font:600 .9rem/1.5 var(--sans);cursor:pointer;border:1px solid var(--accent);border-radius:999px;padding:.7rem 1.2rem;background:var(--accent);color:white;text-decoration:none;display:inline-flex;align-items:center;justify-content:center;gap:.5rem;transition:background .2s,box-shadow .2s,transform .2s;touch-action:manipulation}button:hover,a.download:hover{box-shadow:0 4px 12px #172b3818;transform:translateY(-1px)}button:disabled{cursor:default;opacity:.5;transform:none}button:focus-visible,a:focus-visible,summary:focus-visible,textarea:focus-visible{outline:3px solid #9a5700;outline-offset:4px}[hidden]{display:none!important}.shell{max-width:1240px;margin:auto;padding:2rem 2rem 0}.skip{position:absolute;top:-100px;background:white;padding:1rem;z-index:2}.skip:focus{top:0}header{border-top:4px solid var(--ink);border-bottom:1px solid var(--line);padding:1.5rem 0 1.8rem}.masthead{display:flex;align-items:center;justify-content:space-between;gap:1rem;border-bottom:1px solid var(--line);padding-bottom:1.2rem;margin-bottom:2rem}.brand{font:700 1.65rem var(--serif);letter-spacing:-.04em}.edition{font-size:.75rem;color:var(--muted);letter-spacing:.12em;text-transform:uppercase}.eyebrow{color:var(--accent);font-size:.73rem;font-weight:750;letter-spacing:.17em;text-transform:uppercase}h1,h2,h3{font-family:var(--serif)}h1{font-size:clamp(2rem,4.5vw,3.7rem);font-weight:500;line-height:1.1;max-width:29ch;letter-spacing:-.04em;margin:1rem 0 1.2rem}h2{font-size:1.85rem;font-weight:500;line-height:1.25;letter-spacing:-.025em;margin:.4rem 0 1.4rem}h3{font-size:1.2rem}.subtitle{max-width:78ch;font-size:1.12rem;line-height:1.7;color:var(--muted)}.meta{font-size:.85rem;margin:1.4rem 0}.meta strong{color:var(--ink)}.meta,.muted,small{color:var(--muted)}.badges{display:flex;flex-wrap:wrap;gap:.65rem;margin:1.2rem 0}.badge{display:inline-flex;align-items:center;gap:.55rem;border:1px solid var(--line);border-radius:999px;padding:.5rem .9rem;background:var(--card);font-size:.8rem}.badge small{font-size:inherit}.badge.valid{color:#065f46;border-color:#a7f3d0;background:#ecfdf5}.status-dot{width:8px;height:8px;flex-shrink:0;border-radius:50%;background:#94a3b8}.valid .status-dot{background:#10b981;box-shadow:0 0 0 4px #10b98118;animation:pulse 2s ease-in-out infinite}.notice{font-size:.78rem}.quality{display:inline-flex;flex-wrap:wrap;align-items:center;gap:.5rem;border:1px solid #c9ddd9;background:#f0f8f6;color:#245c55;border-radius:999px;padding:.4rem .8rem;font-size:.78rem;margin:0 0 1rem}nav{display:flex;gap:.5rem;flex-wrap:wrap;margin:1.5rem 0 2rem}nav a{font-size:.85rem;text-decoration:none;color:var(--muted);padding:.5rem .85rem;border-radius:999px}nav a:hover{background:#e9efef;color:var(--accent)}main{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(0,1fr);gap:1.5rem;align-items:start}section{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:2rem;box-shadow:0 4px 20px -2px rgba(0,0,0,.05);min-width:0;scroll-margin-top:1rem}.wide{grid-column:1/-1}.section-head{display:flex;justify-content:space-between;align-items:start;gap:1rem}.section-note{font-size:.8rem;color:var(--muted);max-width:30ch;text-align:right}.tabs{display:flex;flex-wrap:wrap;gap:.6rem;border-bottom:1px solid var(--line);padding-bottom:1rem;margin-bottom:1.3rem}.tabs button{--channel:#0a66c2;border-color:var(--line);border-radius:8px;background:white;color:var(--channel);padding:.65rem 1.15rem}.tabs [data-channel=twitter]{--channel:#0f1419}.tabs [data-channel=newsletter]{--channel:#c2410c}.tabs [data-channel=instagram]{--channel:#a02484}.tabs button[aria-selected=true]{background:var(--channel);border-color:var(--channel);color:white}.tabs [data-channel=instagram][aria-selected=true]{background:linear-gradient(115deg,#7035a0,#b12569)}[role=tabpanel] label{display:block;font-size:.8rem;font-weight:650;color:var(--muted);margin-bottom:.65rem}textarea{display:block;width:100%;min-height:310px;resize:vertical;border:1px solid var(--line);border-radius:8px;background:#fbfcfe;color:var(--ink);padding:1.25rem;font:400 .97rem/1.8 var(--sans)}.actions{display:flex;flex-wrap:wrap;align-items:center;gap:.85rem;margin:1.2rem 0 .2rem}.count{font-size:.8rem;background:#f1f5f9;border-radius:999px;padding:.45rem .8rem;font-variant-numeric:tabular-nums}.count span{font-weight:750;color:var(--ink)}.copy svg{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:1.7}.copy.done{animation:copied .3s ease;background:#047857;border-color:#047857}.feedback{font-size:.85rem;color:#047857}@keyframes copied{50%{transform:scale(1.04)}}@keyframes pulse{50%{box-shadow:0 0 0 6px #10b98108}}pre{white-space:pre-wrap;overflow-wrap:anywhere;font:inherit;margin:1rem 0;max-width:85ch}details{margin-top:1.2rem;padding:1rem 1.1rem;border:1px solid var(--line);border-radius:8px;background:#fbfcfe}summary{cursor:pointer;font-weight:600;font-size:.9rem}audio{display:block;width:100%;margin:1rem 0;accent-color:var(--accent);border-radius:999px;background:#f1f5f9}.audio-intro{color:var(--muted);font-family:var(--serif);font-size:1.12rem}.slide{margin:0}.slide img,.slide iframe{display:block;width:100%;aspect-ratio:4/5;height:auto;object-fit:contain;border:1px solid var(--line);background:#f8fafc;border-radius:8px;box-shadow:0 4px 16px #172b3810}.slide iframe{pointer-events:none}.slide figcaption{font-size:.75rem;color:var(--muted);padding-top:.7rem}.carousel-controls{justify-content:space-between}.carousel-controls button{min-width:48px;min-height:48px;background:white;color:var(--ink);border-color:var(--line)}#position{font-size:.85rem;font-variant-numeric:tabular-nums}.dots{display:flex;justify-content:center;gap:.25rem;flex-wrap:wrap;margin-top:.7rem}.dots button{min-width:44px;min-height:44px;padding:0;border:0;background:transparent}.dots button::before{content:'';width:8px;height:8px;border-radius:50%;background:#b3c1cb;transition:background .2s,transform .2s}.dots button[aria-current=true]::before{background:var(--accent);transform:scale(1.4)}.sr-only{position:absolute;width:1px;height:1px;padding:0;overflow:hidden;clip-path:inset(50%);white-space:nowrap}.table-scroll{overflow-x:auto;margin-top:1.5rem;border:1px solid var(--line);border-radius:8px}table{width:100%;border-collapse:collapse;text-align:left;font-size:.85rem;line-height:1.65}caption{text-align:left;padding:1rem 1.2rem;font-weight:650;background:#fff}th,td{padding:1rem 1.2rem;border-top:1px solid var(--line);vertical-align:top;overflow-wrap:anywhere}th{background:#f8fafc;font-size:.75rem;color:var(--muted);letter-spacing:.04em}tbody tr:hover{background:#fbfcfe}td:nth-child(3){max-width:38ch}ul.files{list-style:none;padding:0;margin-bottom:0;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0 2rem}.files li{display:flex;align-items:center;justify-content:space-between;gap:1rem;border-top:1px solid var(--line);padding:1rem 0}.files span{font-size:.78rem;overflow-wrap:anywhere}.files a{flex-shrink:0;background:white;color:var(--accent);border-color:var(--line);padding:.5rem .85rem}footer{padding:2rem 0;color:var(--muted);font-size:.75rem;line-height:1.8}
@media(max-width:760px){main{grid-template-columns:1fr}.wide{grid-column:auto}.shell{padding:1rem}header{padding-top:1rem}.masthead{align-items:start}.edition{font-size:.65rem;max-width:13ch;text-align:right}section{padding:1.25rem}.section-head{display:block}.section-note{text-align:left;max-width:none}.tabs{gap:.5rem}.tabs button{flex:1 0 40%;padding:.6rem}.files li{align-items:flex-start;flex-direction:column}ul.files{grid-template-columns:1fr}th,td{padding:.75rem}textarea{min-height:340px}.dots{gap:0}.dots button{min-width:44px;min-height:44px}.badge{border-radius:12px}.section-note{display:none}}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*,*::before{animation:none!important;transition:none!important}}
</style>
</head>
<body><a class="skip" href="#main">Vai ai contenuti</a><div class="shell">
<header>
<div class="masthead"><span class="brand">Editorial Hub<span aria-hidden="true">.</span></span><span class="edition">Desk di produzione · Edizione locale</span></div>
<div class="eyebrow">Editorial Pipeline / Console redazionale</div>
<h1>{{ title }}</h1>
{% if subtitle %}<p class="subtitle">{{ subtitle }}</p>{% endif %}
<p class="meta">A cura di <strong>{{ author or 'Autore non disponibile' }}</strong> · <time id="article-date" datetime="{{ date }}">{{ date or 'Data non disponibile' }}</time> · Registro: {{ register or 'Non disponibile' }}</p>
<div class="badges">{% for gate in gates %}{% set validated = gate.status == 'RECEIPT_VALID' %}<div class="badge {{ 'valid' if validated else '' }}"><span class="status-dot" aria-hidden="true"></span><span><strong>Gate {{ gate.number }}{{ ' Validato' if validated else '' }}</strong> · {{ gate.status }}{% if gate.role %}<br><small>{{ gate.role }} · {{ gate.timestamp }}</small>{% endif %}</span></div>{% endfor %}</div>
<p class="muted notice">Anteprima locale · Stato gate registrato, non rivalidato. La console non autorizza la pubblicazione.</p>
</header>
<nav aria-label="Sezioni"><a href="#social">Copy social</a><a href="#carousel">Carosello</a><a href="#audio">Audio</a><a href="#article">Articolo</a><a href="#evidence">Fonti</a><a href="#downloads">Download</a></nav>
<main id="main">
<section id="social" class="wide">
<div class="section-head"><div><div class="eyebrow">01 / Distribuzione</div><h2>Social Copy Hub</h2></div><p class="section-note">Quattro canali, una base documentale. Seleziona e copia il testo.</p></div>
<div class="tabs" role="tablist" aria-label="Canali social">{% for channel in social %}<button type="button" role="tab" id="tab-{{ channel.key }}" aria-controls="panel-{{ channel.key }}" aria-selected="{{ 'true' if loop.first else 'false' }}" tabindex="{{ '0' if loop.first else '-1' }}" data-channel="{{ channel.key }}">{{ channel.label }}</button>{% endfor %}</div>
{% for channel in social %}<div role="tabpanel" id="panel-{{ channel.key }}" aria-labelledby="tab-{{ channel.key }}" {% if not loop.first %}hidden{% endif %}>
<label for="copy-{{ channel.key }}">{{ channel.label }}</label>
<textarea id="copy-{{ channel.key }}" readonly spellcheck="false" placeholder="Non disponibile">{{ channel.text }}</textarea>
<div class="actions"><button type="button" class="copy" data-copy="copy-{{ channel.key }}" {% if not channel.text %}disabled{% endif %}><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="8" y="8" width="12" height="13" rx="2"/><path d="M16 8V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h3"/></svg><span class="copy-label">Copia testo</span></button><small class="count"><span data-count="copy-{{ channel.key }}">{{ channel.text|length }}</span> caratteri</small><span class="feedback" role="status" aria-live="polite"></span></div>
</div>{% endfor %}
</section>
<section id="carousel"><div class="eyebrow">02 / Visual</div><h2>Carosello</h2>
{% if slides %}<div id="slides" aria-label="Slide carosello">{% for slide in slides %}<figure class="slide" {% if not loop.first %}hidden{% endif %}>
{% if slide.html %}<iframe sandbox="" title="Slide {{ loop.index }}" srcdoc="{{ '<meta http-equiv=&quot;Content-Security-Policy&quot; content=&quot;default-src &#39;none&#39;; style-src &#39;unsafe-inline&#39;; img-src data:; base-uri &#39;none&#39;; form-action &#39;none&#39;&quot;>'|replace('&quot;', '"')|replace('&#39;', "'") }}{{ slide.html }}"></iframe>{% else %}<img src="{{ slide.url }}" alt="Slide {{ loop.index }} del carosello">{% endif %}
<figcaption>{{ slide.name }} · <a href="{{ slide.url }}" download>Scarica slide</a></figcaption></figure>{% endfor %}</div>
<div class="actions carousel-controls"><button id="previous" type="button" aria-label="Slide precedente">← Indietro</button><span id="position" role="status" aria-live="polite">1 / {{ slides|length }}</span><button id="next" type="button" aria-label="Slide successiva">Avanti →</button></div>
<div class="dots" aria-label="Seleziona slide">{% for slide in slides %}<button type="button" data-slide="{{ loop.index0 }}" aria-label="Vai alla slide {{ loop.index }}" aria-current="{{ 'true' if loop.first else 'false' }}"><span class="sr-only">{{ loop.index }}</span></button>{% endfor %}</div>
{% else %}<p class="muted">Non disponibile</p>{% endif %}
{% for pdf in pdfs %}<p><a class="download" href="{{ pdf.url }}" download>Scarica PDF · {{ pdf.name }}</a></p>{% endfor %}
</section>
<section id="audio"><div class="eyebrow">03 / Broadcast</div><h2>Podcast e copione</h2>
{% if podcast %}<p class="quality">{{ 'Google NotebookLM Studio' if post_id == 'ai_pensioni' else 'Audio locale' }} <span id="audio-duration"></span></p><p class="audio-intro">L’approfondimento da ascoltare, con il tempo per seguire i passaggi.</p><audio controls preload="metadata" src="{{ podcast }}">Il browser non supporta il player audio.</audio><p><a class="download" href="{{ podcast }}" download>Scarica Podcast</a></p>{% else %}<p class="muted">Non disponibile</p>{% endif %}
{% if script %}<details><summary>Leggi il copione</summary><pre>{{ script }}</pre></details>{% else %}{% set scripts = downloads|selectattr('name', 'equalto', 'dist/audio/' ~ post_id ~ '/podcast_script.md')|list %}{% if scripts %}<details><summary>Copione e scaletta di lavorazione</summary><p>Documento di preparazione; può differire dalla registrazione finale.</p><a href="{{ scripts[0].url }}" download>Scarica il copione Markdown</a></details>{% else %}<p class="muted">Copione: Non disponibile</p>{% endif %}{% endif %}
</section>
<section id="article" class="wide"><div class="eyebrow">04 / Articolo</div><h2>Testi editoriali</h2>
{% if article %}<details open><summary>Testo pubblicato · anteprima testuale</summary><pre>{{ article }}</pre></details>{% endif %}
{% if draft %}<details {% if not article %}open{% endif %}><summary>Bozza · anteprima testuale</summary><pre>{{ draft }}</pre></details>{% endif %}
{% if not article and not draft %}<p class="muted">Non disponibile</p>{% endif %}
</section>
<section id="evidence" class="wide"><div class="eyebrow">05 / Trasparenza</div><h2>Fonti RAG ed evidenze</h2>
<p class="muted">Esiti riportati dai file locali; nessuna nuova verifica eseguita. <span class="quality">Punteggio de-aizing: {{ score }}</span></p>
{% if sources %}<div class="table-scroll"><table><caption>Fonti primarie registrate</caption><thead><tr><th>Chiave</th><th>Fonte</th><th>Riferimento</th><th>Primaria</th></tr></thead><tbody>{% for source in sources %}<tr><td>{{ source.get('key', loop.index) }}</td><td>{{ source.get('title', '') }}</td><td>{{ source.get('url') or source.get('local_copy') or 'Non disponibile' }}</td><td>{{ source.get('primary', 'Non disponibile') }}</td></tr>{% endfor %}</tbody></table></div>{% else %}<p class="muted">Fonti: Non disponibile</p>{% endif %}
{% if claims %}<div class="table-scroll"><table><caption>Citazioni ed esiti registrati</caption><thead><tr><th>N.</th><th>Affermazione</th><th>Fonte / citazione</th><th>Esito</th></tr></thead><tbody>{% for claim in claims %}<tr><td>{{ claim.get('id', loop.index) }}</td><td>{{ claim.get('text', '') }}</td><td>{{ claim.get('source_key', '') }} · {{ claim.get('locator', '') }}</td><td>{{ claim.get('outcome', 'Non disponibile') }}</td></tr>{% endfor %}</tbody></table></div>{% endif %}
</section>
<section id="downloads" class="wide"><div class="eyebrow">06 / Esportazione</div><h2>Export CMS e download</h2><p class="muted">Materiali locali per CMS e pubblicazioni. Ogni utilizzo resta soggetto ai gate umani.</p>
<ul class="files">{% for file in downloads %}<li><span>{{ file.name }}</span><a class="download" href="{{ file.url }}" download>Scarica</a></li>{% endfor %}</ul>
</section>
</main><footer>Editorial Hub · {{ post_id }} · Offline-first. Conserva la pagina insieme alle cartelle del progetto per riprodurre e scaricare gli asset.</footer>
</div>
<script>
const dateLabel = document.getElementById('article-date');
if (dateLabel && /^\d{4}-\d{2}-\d{2}$/.test(dateLabel.dateTime)) {
  const date = new Date(dateLabel.dateTime + 'T12:00:00');
  if (!Number.isNaN(date.getTime())) dateLabel.textContent = new Intl.DateTimeFormat('it-IT', {day:'numeric',month:'long',year:'numeric'}).format(date);
}
const audio = document.querySelector('audio');
if (audio) {
  const showDuration = () => {
    if (Number.isFinite(audio.duration)) document.getElementById('audio-duration').textContent = '· ' + Math.floor(audio.duration / 60) + ':' + String(Math.floor(audio.duration % 60)).padStart(2, '0') + ' min';
  };
  audio.addEventListener('loadedmetadata', showDuration);
  showDuration();
}
const tabs = Array.from(document.querySelectorAll('[role="tab"]'));
function selectTab(tab) {
  tabs.forEach(item => {
    const active = item === tab;
    item.setAttribute('aria-selected', String(active)); item.tabIndex = active ? 0 : -1;
    document.getElementById(item.getAttribute('aria-controls')).hidden = !active;
  });
}
tabs.forEach((tab, index) => {
  tab.addEventListener('click', () => selectTab(tab));
  tab.addEventListener('keydown', event => {
    let next;
    if (event.key === 'ArrowRight') next = (index + 1) % tabs.length;
    else if (event.key === 'ArrowLeft') next = (index - 1 + tabs.length) % tabs.length;
    else if (event.key === 'Home') next = 0;
    else if (event.key === 'End') next = tabs.length - 1;
    else return;
    event.preventDefault(); selectTab(tabs[next]); tabs[next].focus();
  });
});
document.querySelectorAll('[data-count]').forEach(counter => {
  counter.textContent = Array.from(document.getElementById(counter.dataset.count).value).length;
});
document.querySelectorAll('[data-copy]').forEach(button => button.addEventListener('click', async () => {
  const textarea = document.getElementById(button.dataset.copy);
  const feedback = button.parentElement.querySelector('.feedback');
  try {
    if (navigator.clipboard && navigator.clipboard.writeText) await navigator.clipboard.writeText(textarea.value);
    else { textarea.focus(); textarea.select(); if (!document.execCommand('copy')) throw new Error('clipboard'); }
    button.querySelector('.copy-label').textContent = 'Copiato! ✓'; button.classList.add('done'); feedback.textContent = 'Testo copiato';
    setTimeout(() => { button.querySelector('.copy-label').textContent = 'Copia testo'; button.classList.remove('done'); feedback.textContent = ''; }, 1800);
  } catch (error) { textarea.focus(); textarea.select(); feedback.textContent = 'Seleziona e copia il testo con Ctrl+C o Cmd+C.'; }
}));
const slides = Array.from(document.querySelectorAll('.slide'));
const dots = Array.from(document.querySelectorAll('[data-slide]'));
let index = 0;
function showSlide(next) {
  if (!slides.length) return;
  index = (next + slides.length) % slides.length;
  slides.forEach((slide, i) => { slide.hidden = i !== index; });
  dots.forEach((dot, i) => dot.setAttribute('aria-current', String(i === index)));
  document.getElementById('position').textContent = `${index + 1} / ${slides.length}`;
}
if (slides.length) {
  document.getElementById('previous').addEventListener('click', () => showSlide(index - 1));
  document.getElementById('next').addEventListener('click', () => showSlide(index + 1));
  dots.forEach(dot => dot.addEventListener('click', () => showSlide(Number(dot.dataset.slide))));
  let touchX = 0;
  const gallery = document.getElementById('slides');
  gallery.addEventListener('touchstart', event => { touchX = event.changedTouches[0].screenX; }, {passive:true});
  gallery.addEventListener('touchend', event => {
    const delta = event.changedTouches[0].screenX - touchX;
    if (Math.abs(delta) > 45) showSlide(index + (delta < 0 ? 1 : -1));
  }, {passive:true});
}
</script>
</body></html>
