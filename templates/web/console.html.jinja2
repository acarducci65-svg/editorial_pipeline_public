<!doctype html>
<html lang="it">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta http-equiv="Content-Security-Policy" content="default-src 'none'; script-src 'unsafe-inline'; style-src 'unsafe-inline'; img-src 'self' file: data:; media-src 'self' file:; frame-src 'self' about:; connect-src 'none'; font-src 'none'; base-uri 'none'; form-action 'none'">
<title>{{ title }} · Editorial Hub</title>
<style>
:root{color-scheme:light;--ink:#172c35;--muted:#52626b;--paper:#f3f5f2;--accent:#086c5b;--line:#ccd7d1;--card:#fff}
*{box-sizing:border-box}body{margin:0;background:var(--paper);color:var(--ink);font:16px/1.6 system-ui,sans-serif}a{color:var(--accent);overflow-wrap:anywhere}button,a.download{min-height:44px;font:inherit;cursor:pointer;border:1px solid var(--accent);border-radius:.5rem;padding:.55rem .9rem;background:var(--accent);color:white;text-decoration:none;display:inline-block}button:hover,a.download:hover{filter:brightness(.9)}button:disabled{cursor:default;opacity:.5}button:focus-visible,a:focus-visible,summary:focus-visible{outline:3px solid #bd7500;outline-offset:3px}[hidden]{display:none!important}.shell{max-width:1180px;margin:auto;padding:2rem 1.2rem}header{border-bottom:1px solid var(--line);padding:1rem 0 2rem}.eyebrow{color:var(--accent);font-size:.8rem;font-weight:750;letter-spacing:.15em;text-transform:uppercase}h1{font-size:clamp(2rem,5vw,3.6rem);line-height:1.12;max-width:24ch;letter-spacing:-.035em;margin:.7rem 0}h2{font-size:1.4rem;line-height:1.3;margin:0 0 1rem}h3{font-size:1rem}.subtitle{font-size:1.2rem;color:var(--muted)}.meta,.muted,small{color:var(--muted)}.badges{display:flex;flex-wrap:wrap;gap:.7rem;margin:1rem 0}.badge{border:1px solid var(--line);border-radius:.5rem;padding:.6rem .8rem;background:var(--card)}nav{display:flex;gap:1.2rem;flex-wrap:wrap;margin:1.2rem 0}nav a{font-size:.9rem}main{display:grid;grid-template-columns:minmax(0,1.25fr) minmax(0,1fr);gap:1.2rem}section{background:var(--card);border:1px solid var(--line);border-radius:.9rem;padding:1.4rem;min-width:0;scroll-margin-top:1rem}.wide{grid-column:1/-1}.tabs{display:flex;flex-wrap:wrap;gap:.5rem;margin-bottom:1rem}.tabs button{background:transparent;color:var(--accent)}.tabs button[aria-selected=true]{background:var(--accent);color:white}textarea{display:block;width:100%;min-height:200px;resize:vertical;border:1px solid var(--line);border-radius:.5rem;background:#fafbf9;color:var(--ink);padding:1rem;font:inherit}.actions{display:flex;flex-wrap:wrap;align-items:center;gap:.8rem;margin:1rem 0}.copy.done{animation:copied .35s ease;background:#135f35}@keyframes copied{50%{transform:scale(1.04)}}pre{white-space:pre-wrap;overflow-wrap:anywhere;font:inherit;margin:.6rem 0}details{margin-top:1rem}summary{cursor:pointer;font-weight:650}audio{width:100%;margin:.5rem 0}.slide{margin:0}.slide img,.slide iframe{display:block;width:100%;height:440px;object-fit:contain;border:0;background:#f1f3f0;border-radius:.5rem}.slide iframe{pointer-events:none}.slide figcaption{font-size:.85rem;color:var(--muted)}.dots{display:flex;gap:.5rem;flex-wrap:wrap}.dots button{min-width:44px;padding:.2rem .6rem;background:transparent;color:var(--accent)}.dots button[aria-current=true]{background:var(--accent);color:white}.table-scroll{overflow-x:auto}table{width:100%;border-collapse:collapse;text-align:left;font-size:.92rem}th,td{padding:.8rem;border-bottom:1px solid var(--line);vertical-align:top;overflow-wrap:anywhere}th{background:#f3f5f2}ul.files{list-style:none;padding:0}.files li{display:flex;align-items:center;justify-content:space-between;gap:1rem;border-top:1px solid var(--line);padding:.7rem 0}.files span{font-size:.85rem;overflow-wrap:anywhere}.files a{flex-shrink:0}footer{padding:2rem 0;color:var(--muted);font-size:.85rem}@media(max-width:760px){main{grid-template-columns:1fr}.wide{grid-column:auto}.shell{padding:1rem .7rem}section{padding:1rem}.slide img,.slide iframe{height:360px}.files li{align-items:flex-start;flex-direction:column}th,td{padding:.5rem}}@media(prefers-reduced-motion:reduce){*{animation:none!important}}
</style>
</head>
<body><div class="shell">
<header>
<div class="eyebrow">Editorial Pipeline / Console redazionale</div>
<h1>{{ title }}</h1>
{% if subtitle %}<p class="subtitle">{{ subtitle }}</p>{% endif %}
<p class="meta">{{ author or 'Autore non disponibile' }} · {{ date or 'Data non disponibile' }} · Registro: {{ register or 'Non disponibile' }}</p>
<div class="badges">{% for gate in gates %}<div class="badge"><strong>Gate {{ gate.number }}</strong> · {{ gate.status }}{% if gate.role %}<br><small>{{ gate.role }} · {{ gate.timestamp }}</small>{% endif %}</div>{% endfor %}</div>
<p class="muted">Anteprima locale · Stato gate registrato, non rivalidato. La console non autorizza la pubblicazione.</p>
</header>
<nav aria-label="Sezioni"><a href="#social">Copy social</a><a href="#carousel">Carosello</a><a href="#audio">Audio</a><a href="#article">Articolo</a><a href="#evidence">Fonti</a><a href="#downloads">Download</a></nav>
<main>
<section id="social" class="wide">
<div class="eyebrow">01 / Distribuzione</div><h2>Social Copy Hub</h2>
<div class="tabs" role="tablist" aria-label="Canali social">{% for channel in social %}<button type="button" role="tab" id="tab-{{ channel.key }}" aria-controls="panel-{{ channel.key }}" aria-selected="{{ 'true' if loop.first else 'false' }}" tabindex="{{ '0' if loop.first else '-1' }}" data-channel="{{ channel.key }}">{{ channel.label }}</button>{% endfor %}</div>
{% for channel in social %}<div role="tabpanel" id="panel-{{ channel.key }}" aria-labelledby="tab-{{ channel.key }}" {% if not loop.first %}hidden{% endif %}>
<label for="copy-{{ channel.key }}">{{ channel.label }}</label>
<textarea id="copy-{{ channel.key }}" readonly spellcheck="false" placeholder="Non disponibile">{{ channel.text }}</textarea>
<div class="actions"><button type="button" class="copy" data-copy="copy-{{ channel.key }}" {% if not channel.text %}disabled{% endif %}>Copia testo</button><small><span data-count="copy-{{ channel.key }}">{{ channel.text|length }}</span> caratteri</small><span class="feedback" role="status" aria-live="polite"></span></div>
</div>{% endfor %}
</section>
<section id="carousel"><div class="eyebrow">02 / Visual</div><h2>Carosello</h2>
{% if slides %}<div id="slides" aria-label="Slide carosello">{% for slide in slides %}<figure class="slide" {% if not loop.first %}hidden{% endif %}>
{% if slide.html %}<iframe sandbox="" title="Slide {{ loop.index }}" srcdoc="{{ '<meta http-equiv=&quot;Content-Security-Policy&quot; content=&quot;default-src &#39;none&#39;; style-src &#39;unsafe-inline&#39;; img-src data:; base-uri &#39;none&#39;; form-action &#39;none&#39;&quot;>'|replace('&quot;', '"')|replace('&#39;', "'") }}{{ slide.html }}"></iframe>{% else %}<img src="{{ slide.url }}" alt="Slide {{ loop.index }} del carosello">{% endif %}
<figcaption>{{ slide.name }} · <a href="{{ slide.url }}" download>Scarica slide</a></figcaption></figure>{% endfor %}</div>
<div class="actions"><button id="previous" type="button" aria-label="Slide precedente">← Indietro</button><span id="position" role="status" aria-live="polite">1 / {{ slides|length }}</span><button id="next" type="button" aria-label="Slide successiva">Avanti →</button></div>
<div class="dots" aria-label="Seleziona slide">{% for slide in slides %}<button type="button" data-slide="{{ loop.index0 }}" aria-label="Vai alla slide {{ loop.index }}" aria-current="{{ 'true' if loop.first else 'false' }}">{{ loop.index }}</button>{% endfor %}</div>
{% else %}<p class="muted">Non disponibile</p>{% endif %}
{% for pdf in pdfs %}<p><a class="download" href="{{ pdf.url }}" download>Scarica PDF · {{ pdf.name }}</a></p>{% endfor %}
</section>
<section id="audio"><div class="eyebrow">03 / Broadcast</div><h2>Podcast e copione</h2>
{% if podcast %}<audio controls preload="metadata" src="{{ podcast }}">Il browser non supporta il player audio.</audio><p><a class="download" href="{{ podcast }}" download>Scarica podcast</a></p>{% else %}<p class="muted">Non disponibile</p>{% endif %}
{% if script %}<details><summary>Leggi il copione</summary><pre>{{ script }}</pre></details>{% else %}<p class="muted">Copione: Non disponibile</p>{% endif %}
</section>
<section id="article" class="wide"><div class="eyebrow">04 / Articolo</div><h2>Testi editoriali</h2>
{% if article %}<details open><summary>Testo pubblicato · anteprima testuale</summary><pre>{{ article }}</pre></details>{% endif %}
{% if draft %}<details {% if not article %}open{% endif %}><summary>Bozza · anteprima testuale</summary><pre>{{ draft }}</pre></details>{% endif %}
{% if not article and not draft %}<p class="muted">Non disponibile</p>{% endif %}
</section>
<section id="evidence" class="wide"><div class="eyebrow">05 / Trasparenza</div><h2>Fonti RAG ed evidenze</h2>
<p class="muted">Esiti riportati dai file locali; nessuna nuova verifica eseguita. Punteggio de-aizing: {{ score }}</p>
{% if sources %}<div class="table-scroll"><table><caption>Fonti primarie registrate</caption><thead><tr><th>Chiave</th><th>Fonte</th><th>Riferimento</th><th>Primaria</th></tr></thead><tbody>{% for source in sources %}<tr><td>{{ source.get('key', loop.index) }}</td><td>{{ source.get('title', '') }}</td><td>{{ source.get('url') or source.get('local_copy') or 'Non disponibile' }}</td><td>{{ source.get('primary', 'Non disponibile') }}</td></tr>{% endfor %}</tbody></table></div>{% else %}<p class="muted">Fonti: Non disponibile</p>{% endif %}
{% if claims %}<div class="table-scroll"><table><caption>Citazioni ed esiti registrati</caption><thead><tr><th>N.</th><th>Affermazione</th><th>Fonte / citazione</th><th>Esito</th></tr></thead><tbody>{% for claim in claims %}<tr><td>{{ claim.get('id', loop.index) }}</td><td>{{ claim.get('text', '') }}</td><td>{{ claim.get('source_key', '') }} · {{ claim.get('locator', '') }}</td><td>{{ claim.get('outcome', 'Non disponibile') }}</td></tr>{% endfor %}</tbody></table></div>{% endif %}
</section>
<section id="downloads" class="wide"><div class="eyebrow">06 / Esportazione</div><h2>File e bundle disponibili</h2><p class="muted">Materiali locali per CMS e pubblicazioni. Ogni utilizzo resta soggetto ai gate umani.</p>
<ul class="files">{% for file in downloads %}<li><span>{{ file.name }}</span><a class="download" href="{{ file.url }}" download>Scarica</a></li>{% endfor %}</ul>
</section>
</main><footer>Editorial Hub · {{ post_id }} · Offline-first. Conserva la pagina insieme alle cartelle del progetto per riprodurre e scaricare gli asset.</footer>
</div>
<script>
const tabs = Array.from(document.querySelectorAll('[role="tab"]'));
function selectTab(tab) {
  tabs.forEach(item => {
    const active = item === tab;
    item.setAttribute('aria-selected', String(active)); item.tabIndex = active ? 0 : -1;
    document.getElementById(item.getAttribute('aria-controls')).hidden = !active;
  });
}
tabs.forEach((tab, index) => {
  tab.addEventListener('click', () => selectTab(tab));
  tab.addEventListener('keydown', event => {
    let next;
    if (event.key === 'ArrowRight') next = (index + 1) % tabs.length;
    else if (event.key === 'ArrowLeft') next = (index - 1 + tabs.length) % tabs.length;
    else if (event.key === 'Home') next = 0;
    else if (event.key === 'End') next = tabs.length - 1;
    else return;
    event.preventDefault(); selectTab(tabs[next]); tabs[next].focus();
  });
});
document.querySelectorAll('[data-count]').forEach(counter => {
  counter.textContent = Array.from(document.getElementById(counter.dataset.count).value).length;
});
document.querySelectorAll('[data-copy]').forEach(button => button.addEventListener('click', async () => {
  const textarea = document.getElementById(button.dataset.copy);
  const feedback = button.parentElement.querySelector('.feedback');
  try {
    if (navigator.clipboard && navigator.clipboard.writeText) await navigator.clipboard.writeText(textarea.value);
    else { textarea.focus(); textarea.select(); if (!document.execCommand('copy')) throw new Error('clipboard'); }
    button.textContent = 'Copiato!'; button.classList.add('done'); feedback.textContent = 'Testo copiato';
    setTimeout(() => { button.textContent = 'Copia testo'; button.classList.remove('done'); feedback.textContent = ''; }, 1800);
  } catch (error) { textarea.focus(); textarea.select(); feedback.textContent = 'Seleziona e copia il testo con Ctrl+C o Cmd+C.'; }
}));
const slides = Array.from(document.querySelectorAll('.slide'));
const dots = Array.from(document.querySelectorAll('[data-slide]'));
let index = 0;
function showSlide(next) {
  if (!slides.length) return;
  index = (next + slides.length) % slides.length;
  slides.forEach((slide, i) => { slide.hidden = i !== index; });
  dots.forEach((dot, i) => dot.setAttribute('aria-current', String(i === index)));
  document.getElementById('position').textContent = `${index + 1} / ${slides.length}`;
}
if (slides.length) {
  document.getElementById('previous').addEventListener('click', () => showSlide(index - 1));
  document.getElementById('next').addEventListener('click', () => showSlide(index + 1));
  dots.forEach(dot => dot.addEventListener('click', () => showSlide(Number(dot.dataset.slide))));
  let touchX = 0;
  const gallery = document.getElementById('slides');
  gallery.addEventListener('touchstart', event => { touchX = event.changedTouches[0].screenX; }, {passive:true});
  gallery.addEventListener('touchend', event => {
    const delta = event.changedTouches[0].screenX - touchX;
    if (Math.abs(delta) > 45) showSlide(index + (delta < 0 ? 1 : -1));
  }, {passive:true});
}
</script>
</body></html>
