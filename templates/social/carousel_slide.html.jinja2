{#-
  Carousel slide template — Editorial Pipeline (Apache-2.0).

  Offline-first: no remote fonts, CDNs, scripts or external images.
  Only system font stacks and inline CSS are used.

  Visual direction "Modern Tech": slate background, night-blue ink, cobalt
  accent, crisp sans-serif. Colours and font family come from the project
  [theme] table in editorial.toml (see ThemeConfig); every value has a default
  so the template also renders without a theme.

  Context:
    spec    CarouselSpec  (post_id, title, subtitle, author, slides, aspect_ratio)
    slides  list[Slide]   slides rendered in this document (one per file,
                          or all of them for the PDF deck)
    total   int           total number of slides in the carousel
    width   int           slide width in CSS pixels  (1080)
    height  int           slide height in CSS pixels (1350 for 4:5, 1080 for 1:1)
    lang    str           BCP 47 language tag of the content
    theme   dict          optional: accent_color, background_color, ink_color,
                          font_family ("sans" | "serif")
-#}
{%- set th = theme if theme is defined and theme else {} -%}
{%- set accent = th.get('accent_color', '#2563eb') -%}
{%- set bg = th.get('background_color', '#f8fafc') -%}
{%- set ink = th.get('ink_color', '#0f172a') -%}
{%- set serif_body = th.get('font_family', 'sans') == 'serif' -%}
<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="generator" content="editorial-pipeline">
<title>{{ spec.title }}{% if slides|length == 1 %} — {{ slides[0].number }}/{{ total }}{% endif %}</title>
<style>
  :root {
    --bg: {{ bg }};
    --ink: {{ ink }};
    --accent: {{ accent }};
    /* Derived tones stay in the theme's own hue family. */
    --surface: #ffffff;
    --muted: color-mix(in oklab, var(--ink) 70%, var(--bg));
    --line: color-mix(in oklab, var(--ink) 12%, var(--bg));
    --accent-soft: color-mix(in oklab, var(--accent) 9%, #ffffff);
    --accent-line: color-mix(in oklab, var(--accent) 28%, #ffffff);
    --on-ink: #ffffff;
    --on-ink-muted: color-mix(in oklab, #ffffff 74%, var(--ink));
    --sans: "Inter", "Segoe UI Variable Display", "Segoe UI", system-ui, -apple-system, Roboto, "Helvetica Neue", Arial, "Noto Sans", sans-serif;
    --serif: "Source Serif 4", "Iowan Old Style", "Palatino Linotype", Georgia, serif;
    --body: {{ 'var(--serif)' if serif_body else 'var(--sans)' }};
    --mono: "JetBrains Mono", "Cascadia Mono", "SF Mono", Consolas, ui-monospace, monospace;
  }
  @page { size: {{ width }}px {{ height }}px; margin: 0; }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  html, body { background: var(--bg); color: var(--ink); }
  body {
    font-family: var(--sans);
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
  }
  .slide {
    container-type: size;
    position: relative;
    width: 100%;
    max-width: {{ width }}px;
    aspect-ratio: {{ width }} / {{ height }};
    margin: 0 auto;
    overflow: hidden;
    background: var(--bg);
    break-after: page;
    page-break-after: always;
  }
  .slide:last-child { break-after: auto; page-break-after: auto; }
  .frame {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    padding: 88px 92px 80px;
    padding: 8.1cqw 8.5cqw 7.4cqw;
  }
  .topbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 32px;
    font-size: 24px;
    font-size: 2.2cqw;
    font-weight: 600;
    color: var(--muted);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .brand::before {
    content: "";
    flex: none;
    width: 0.62em;
    height: 0.62em;
    border-radius: 0.16em;
    background: var(--accent);
  }
  .count {
    font-family: var(--mono);
    font-variant-numeric: tabular-nums;
    font-weight: 600;
    color: var(--accent);
    white-space: nowrap;
  }
  .body {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    justify-content: safe center;
    gap: 40px;
    gap: 3.7cqw;
    min-height: 0;
  }
  h1 {
    font-family: var(--sans);
    font-weight: 750;
    font-size: 72px;
    font-size: 6.7cqw;
    line-height: 1.08;
    letter-spacing: -0.025em;
    text-wrap: balance;
    overflow-wrap: break-word;
  }
  .text p {
    font-family: var(--body);
    font-size: 39px;
    font-size: 3.6cqw;
    line-height: 1.48;
    max-width: 32ch;
    color: color-mix(in oklab, var(--ink) 88%, var(--bg));
    hyphens: none;
    overflow-wrap: break-word;
  }
  .text p + p { margin-top: 0.75em; }
  .highlight {
    position: relative;
    padding: 34px 40px 36px 104px;
    padding: 3.1cqw 3.7cqw 3.3cqw 9.6cqw;
    border: 2px solid var(--accent-line);
    border-radius: 28px;
    border-radius: 2.6cqw;
    background: var(--accent-soft);
    font-size: 40px;
    font-size: 3.7cqw;
    font-weight: 650;
    line-height: 1.32;
    letter-spacing: -0.01em;
    color: var(--ink);
  }
  .highlight::before {
    content: "";
    position: absolute;
    left: 3.7cqw;
    top: 3.6cqw;
    width: 3.4cqw;
    height: 3.4cqw;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: inset 0 0 0 0.9cqw var(--accent-soft);
  }
  .footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 32px;
    padding-top: 28px;
    padding-top: 2.6cqw;
    border-top: 2px solid var(--line);
    font-size: 24px;
    font-size: 2.2cqw;
    color: var(--muted);
  }
  .steps { display: flex; gap: 0.5cqw; align-items: center; }
  .steps span {
    width: 1.6cqw;
    height: 0.7cqw;
    border-radius: 999px;
    background: var(--line);
  }
  .steps span.done { background: color-mix(in oklab, var(--accent) 40%, #ffffff); }
  .steps span.now { width: 4.4cqw; background: var(--accent); }
  .next {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    font-weight: 600;
    color: var(--accent);
    white-space: nowrap;
  }
  /* Cover: the one committed surface of the deck. */
  .cover { background: var(--ink); color: var(--on-ink); }
  .cover::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image: radial-gradient(color-mix(in oklab, #ffffff 13%, var(--ink)) 1.5px, transparent 1.6px);
    background-size: 3.4cqw 3.4cqw;
    -webkit-mask-image: linear-gradient(160deg, #000 0%, transparent 62%);
    mask-image: linear-gradient(160deg, #000 0%, transparent 62%);
  }
  .cover .topbar, .cover .footer { color: var(--on-ink-muted); }
  .cover .count { color: #ffffff; }
  .cover .footer { border-top-color: color-mix(in oklab, #ffffff 16%, var(--ink)); }
  .cover .body { justify-content: flex-end; padding-bottom: 3.2cqw; }
  .cover h1 { font-size: 88px; font-size: 8.2cqw; line-height: 1.03; letter-spacing: -0.03em; }
  .cover .subtitle {
    font-family: var(--body);
    font-size: 38px;
    font-size: 3.5cqw;
    line-height: 1.4;
    max-width: 30ch;
    color: var(--on-ink-muted);
  }
  .cover .text p { color: var(--on-ink-muted); }
  .cover .highlight { background: color-mix(in oklab, var(--accent) 22%, var(--ink)); border-color: color-mix(in oklab, var(--accent) 45%, var(--ink)); color: #ffffff; }
  .cover .highlight::before { box-shadow: inset 0 0 0 0.9cqw color-mix(in oklab, var(--accent) 22%, var(--ink)); }
  .cover .tag {
    align-self: flex-start;
    padding: 0.45em 0.9em;
    border-radius: 999px;
    background: var(--accent);
    color: #ffffff;
    font-size: 24px;
    font-size: 2.2cqw;
    font-weight: 650;
  }
  .cover .steps span { background: color-mix(in oklab, #ffffff 22%, var(--ink)); }
  .cover .steps span.now { background: var(--accent); }
  .cover .next { color: #ffffff; }
</style>
</head>
<body>
{%- for slide in slides %}
<section class="slide{% if slide.number == 1 %} cover{% endif %}" id="slide-{{ slide.number }}" aria-label="{{ slide.number }} / {{ total }}">
  <div class="frame">
    <header class="topbar">
      <span class="brand">{{ spec.author }}</span>
      <span class="count">{{ '%02d'|format(slide.number) }} / {{ '%02d'|format(total) }}</span>
    </header>
    <main class="body">
      {%- if slide.number == 1 %}
      <span class="tag">{{ 'Scorri' if total > 1 else 'Approfondimento' }}{% if total > 1 %} · {{ total }} slide{% endif %}</span>
      {%- endif %}
      <h1>{{ slide.title }}</h1>
      {%- if slide.number == 1 and spec.subtitle %}
      <p class="subtitle">{{ spec.subtitle }}</p>
      {%- endif %}
      {%- if slide.text %}
      <div class="text">
        {%- for paragraph in slide.text.split('\n\n') if paragraph.strip() %}
        <p>{{ paragraph.strip() }}</p>
        {%- endfor %}
      </div>
      {%- endif %}
      {%- if slide.highlight %}
      <blockquote class="highlight">{{ slide.highlight }}</blockquote>
      {%- endif %}
    </main>
    <footer class="footer">
      <span class="steps" aria-hidden="true">{% for step in range(1, total + 1) %}<span class="{{ 'now' if step == slide.number else ('done' if step < slide.number else '') }}"></span>{% endfor %}</span>
      <span class="next" aria-hidden="true">{% if slide.number < total %}Continua &rarr;{% endif %}</span>
    </footer>
  </div>
</section>
{%- endfor %}
</body>
</html>
