{#-
  Carousel slide template — Editorial Pipeline (Apache-2.0).

  Offline-first: no remote fonts, CDNs, scripts or external images.
  Only system font stacks and inline CSS are used.

  Context:
    spec    CarouselSpec  (post_id, title, subtitle, author, slides, aspect_ratio)
    slides  list[Slide]   slides rendered in this document (one per file,
                          or all of them for the PDF deck)
    total   int           total number of slides in the carousel
    width   int           slide width in CSS pixels  (1080)
    height  int           slide height in CSS pixels (1350 for 4:5, 1080 for 1:1)
    lang    str           BCP 47 language tag of the content
-#}
<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="generator" content="editorial-pipeline">
<title>{{ spec.title }}{% if slides|length == 1 %} — {{ slides[0].number }}/{{ total }}{% endif %}</title>
<style>
  :root {
    --paper: #f6f3ee;
    --ink: #1f2328;
    --muted: #5b6168;
    --rule: #d9d3c7;
    --accent: #8f3b2b;
    --accent-soft: #efe4dc;
    --serif: "Iowan Old Style", "Palatino Linotype", Palatino, "Book Antiqua", Georgia, "Times New Roman", serif;
    --sans: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, "Noto Sans", sans-serif;
  }
  @page { size: {{ width }}px {{ height }}px; margin: 0; }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  html, body { background: var(--paper); color: var(--ink); }
  body {
    font-family: var(--sans);
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
  }
  .slide {
    container-type: size;
    position: relative;
    width: 100%;
    max-width: {{ width }}px;
    aspect-ratio: {{ width }} / {{ height }};
    margin: 0 auto;
    overflow: hidden;
    background: var(--paper);
    break-after: page;
    page-break-after: always;
  }
  .slide:last-child { break-after: auto; page-break-after: auto; }
  .frame {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    padding: 96px 96px 88px;
    padding: 8.9cqw 8.9cqw 8.1cqw;
  }
  .kicker {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 32px;
    padding-bottom: 28px;
    padding-bottom: 2.6cqw;
    border-bottom: 2px solid var(--rule);
    font-size: 26px;
    font-size: 2.4cqw;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .kicker .series { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .kicker .count { font-variant-numeric: tabular-nums; color: var(--accent); white-space: nowrap; }
  .body { flex: 1; display: flex; flex-direction: column; justify-content: center; gap: 44px; gap: 4.1cqw; }
  h1 {
    font-family: var(--serif);
    font-weight: 600;
    font-size: 76px;
    font-size: 7cqw;
    line-height: 1.12;
    letter-spacing: -0.01em;
    text-wrap: balance;
    overflow-wrap: break-word;
  }
  .subtitle {
    font-family: var(--serif);
    font-style: italic;
    font-size: 40px;
    font-size: 3.7cqw;
    line-height: 1.35;
    color: var(--muted);
  }
  .text p {
    font-size: 40px;
    font-size: 3.7cqw;
    line-height: 1.5;
    max-width: 34ch;
    hyphens: auto;
    overflow-wrap: break-word;
  }
  .text p + p { margin-top: 0.8em; }
  .highlight {
    padding: 32px 40px;
    padding: 3cqw 3.7cqw;
    border-left: 8px solid var(--accent);
    background: var(--accent-soft);
    font-family: var(--serif);
    font-size: 44px;
    font-size: 4.1cqw;
    line-height: 1.35;
    color: var(--ink);
  }
  .cover h1 { font-size: 96px; font-size: 8.9cqw; line-height: 1.06; }
  .cover .body { justify-content: flex-end; padding-bottom: 4cqw; }
  .cover .rule { width: 18%; height: 8px; background: var(--accent); }
  .footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 32px;
    padding-top: 28px;
    padding-top: 2.6cqw;
    font-size: 26px;
    font-size: 2.4cqw;
    color: var(--muted);
  }
  .footer .author { font-weight: 600; color: var(--ink); }
  .progress {
    position: absolute;
    left: 0;
    bottom: 0;
    height: 12px;
    height: 1.1cqw;
    background: var(--accent);
  }
</style>
</head>
<body>
{%- for slide in slides %}
<section class="slide{% if slide.number == 1 %} cover{% endif %}" id="slide-{{ slide.number }}" aria-label="{{ slide.number }} / {{ total }}">
  <div class="frame">
    <header class="kicker">
      <span class="series">{{ spec.title }}</span>
      <span class="count">{{ '%02d'|format(slide.number) }} / {{ '%02d'|format(total) }}</span>
    </header>
    <main class="body">
      {%- if slide.number == 1 %}
      <div class="rule" aria-hidden="true"></div>
      {%- endif %}
      <h1>{{ slide.title }}</h1>
      {%- if slide.number == 1 and spec.subtitle %}
      <p class="subtitle">{{ spec.subtitle }}</p>
      {%- endif %}
      {%- if slide.text %}
      <div class="text">
        {%- for paragraph in slide.text.split('\n\n') if paragraph.strip() %}
        <p>{{ paragraph.strip() }}</p>
        {%- endfor %}
      </div>
      {%- endif %}
      {%- if slide.highlight %}
      <blockquote class="highlight">{{ slide.highlight }}</blockquote>
      {%- endif %}
    </main>
    <footer class="footer">
      <span class="author">{{ spec.author }}</span>
      <span class="next" aria-hidden="true">{% if slide.number < total %}&rarr;{% endif %}</span>
    </footer>
  </div>
  <div class="progress" style="width: {{ (slide.number / total * 100)|round(2) }}%" aria-hidden="true"></div>
</section>
{%- endfor %}
</body>
</html>
